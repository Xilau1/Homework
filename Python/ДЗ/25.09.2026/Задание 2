N1 = int(input("Число:"))
N2 = int(input("Число:"))
N3 = int(input("Число:"))

print("1. Максимальное число")
print("2. Минимальное число")
print("3. Среднеарифмитическое чисел")
N = int(input("Число:"))

if N == 1:
    print(f"Максимальное число: {max(N1, N2, N3)}")
elif N == 2:
    print(f"Минимальное число: {min(N1, N2, N3)}")
elif N == 3:
    ARN = sum([N1, N2, N3])
    print(f"Среднеарифмитическое чисел: {ARN / 3}")